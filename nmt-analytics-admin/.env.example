# Environment Configuration for NMT Analytics Admin

# Supabase Configuration
# Get these from: https://app.supabase.com > Your Project > Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co

# IMPORTANT: Use the "anon" / "public" key here, NOT the service_role key!
# The service_role key should ONLY be used server-side (in the API).
# Using service_role in the browser is a critical security risk.
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# API URL (optional - defaults to /api which uses Vite proxy)
# VITE_API_URL=http://localhost:3001

# Error Monitoring (Sentry)
# Optional. Bundled at build time — must be present when `vite build` runs,
# not at container start. When unset the SDK is never initialised.
# Use a SEPARATE Sentry project from the API's SENTRY_DSN: browser and server
# errors have different noise profiles and different owners.
# VITE_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# Optional. Release tag shown on every captured event.
# VITE_APP_VERSION=travline-admin@1.0.0
