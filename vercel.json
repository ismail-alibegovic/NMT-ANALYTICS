{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --prefix nmt-analytics-api && npm ci --prefix nmt-analytics-admin",
  "buildCommand": "npm run build --prefix nmt-analytics-admin",
  "outputDirectory": "nmt-analytics-admin/dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
