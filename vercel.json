{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --prefix nmt-analytics-admin",
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "nmt-analytics-admin/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://travline-sprypine.zocomputer.io/api/:path*"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
