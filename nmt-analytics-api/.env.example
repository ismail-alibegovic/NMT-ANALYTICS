# Environment Configuration for NMT Analytics API

# Node Environment
NODE_ENV=development

# Server Port (defaults to 3001 in development)
PORT=3001

# Travline Supabase Configuration
TRAVLINE_SUPABASE_PROJECT_REF=hacutwknfgufrqlgdiia
TRAVLINE_SUPABASE_URL=https://hacutwknfgufrqlgdiia.supabase.co
# Optional. Used for client-side operations if provided.
TRAVLINE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Required. Used for server-side operations and authentication.
TRAVLINE_SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Optional. Used only for applying migrations through the Management API.
TRAVLINE_SUPABASE_MANAGEMENT_TOKEN=sbp_your-management-token-here

# Admin Frontend URL for CORS
# Optional. Defaults to http://localhost:5173 in development.
ADMIN_URL=http://localhost:5173

# Error Monitoring (Sentry)
# Optional. When unset, the SDK is never initialised — no network calls, no
# instrumentation, zero overhead. Read at process start by src/instrument.ts.
# Use a SEPARATE Sentry project from the admin SPA's VITE_SENTRY_DSN so
# backend failures and browser crashes stay independently triageable.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# Optional. Overrides NODE_ENV as the environment label on captured events.
# SENTRY_ENVIRONMENT=production
# Optional. Release tag for grouping regressions by deploy.
# SENTRY_RELEASE=travline-api@1.0.0

# Development Mode Bypass (NEVER use in production)
# DEV_BYPASS_AUTH=true
# DEV_ORG_ID=your-org-uuid-here

# Development Auto-Bootstrap (creates org/profile/modules automatically)
# DEV_AUTO_BOOTSTRAP=true
# DEV_DEFAULT_ORG_NAME=NMT Analytics
# DEV_DEFAULT_ROLE=director
# DEV_DEFAULT_MODULES=dashboard,customers,packages,reservations,departures,payments,transactions
