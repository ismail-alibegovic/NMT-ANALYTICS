# Local-only acceptance environment. Never point these values at production.
NODE_ENV=staging
TRAVLINE_SUPABASE_URL=http://127.0.0.1:54321
TRAVLINE_SUPABASE_ANON_KEY=<local-anon-key-from-supabase-status>
TRAVLINE_SUPABASE_SERVICE_ROLE_KEY=<local-service-role-key-from-supabase-status>
ADMIN_URL=http://127.0.0.1:5173
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<local-anon-key-from-supabase-status>
VITE_API_URL=http://127.0.0.1:3001/api

# Playwright credentials are created only by seed:acceptance.
E2E_BASE_URL=http://127.0.0.1:5173
E2E_API_URL=http://127.0.0.1:3001
E2E_SUPABASE_URL=http://127.0.0.1:54321
E2E_SUPABASE_ANON_KEY=<local-anon-key-from-supabase-status>
E2E_MANAGER_EMAIL=manager@pilot-a.test
E2E_MANAGER_PASSWORD=<generated-local-password>
E2E_STAFF_EMAIL=staff@pilot-a.test
E2E_STAFF_PASSWORD=<generated-local-password>
E2E_OTHER_TENANT_EMAIL=manager@pilot-b.test
E2E_OTHER_TENANT_PASSWORD=<generated-local-password>
E2E_DEPARTURE_ID=<seed output>
E2E_CUSTOMER_ID=<seed output>
